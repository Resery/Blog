---
import { getCollection } from 'astro:content';
import PostPreview from '../../components/PostPreview.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sortItemsByDateDesc } from '../../utils/data-utils';
const posts = (await getCollection('blog')).filter(({ data }) => data.lang === 'en').sort(sortItemsByDateDesc);
---

<BaseLayout title="Blog" description="All writing from Resery Blog." showHeader={false} locale="en" alternateUrl="/Blog/zh/blog/">
    <h1 class="mb-12 font-serif text-3xl leading-tight font-medium sm:mb-16 sm:text-5xl">Blog</h1>
    {posts.map((post) => <PostPreview post={post} class="mb-10 sm:mb-12" locale="en" />)}
</BaseLayout>
