---
type Props = { date: Date; locale?: 'en' | 'zh' };

const { date, locale = 'en' } = Astro.props;
---

<time datetime={date.toISOString()}>
    {
        date.toLocaleDateString(locale === 'zh' ? 'zh-CN' : 'en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric'
        })
    }
</time>
