---
type Props = { locale?: 'en' | 'zh' };
const { locale = 'en' } = Astro.props;
const zh = locale === 'zh';
const cves = [
    { year: '2026', items: ['20424', '20425', '20426', '20427', '20428', '20429', '20447', '20448', '20521'] },
    { year: '2024', items: ['20013', '20083', '20088', '20090', '20091', '20092', '20093', '20095', '20096', '20097', '20107', '20116', '20136', '20105'] },
    { year: '2023', items: ['20634', '20635', '20708', '20711', '20755', '20757', '20758', '20759', '20780', '20823', '20833', '32818', '32819', '32821', '32872', '32873', '32875', '32876'] }
];
---

<div class="academic-layout">
    <aside class="profile-sidebar">
        <img
            class="profile-avatar"
            src="https://avatars.githubusercontent.com/u/50428593?v=4"
            alt="Resery"
            width="180"
            height="180"
            loading="eager"
        />
        <h1>Resery</h1>
        <ul class="profile-links" aria-label={zh ? '个人链接' : 'Profile links'}>
            <li>
                <a href="mailto:resery.sec@gmail.com">
                    <img src="https://api.iconify.design/lucide/mail.svg" alt="" aria-hidden="true" />
                    <span>resery.sec@gmail.com</span>
                </a>
            </li>
            <li>
                <a href="https://github.com/Resery" target="_blank" rel="noopener noreferrer">
                    <img src="https://api.iconify.design/simple-icons/github.svg" alt="" aria-hidden="true" />
                    <span>Resery</span>
                </a>
            </li>
            <li>
                <a href="https://x.com/Resery4" target="_blank" rel="noopener noreferrer">
                    <img src="https://api.iconify.design/simple-icons/x.svg" alt="" aria-hidden="true" />
                    <span>@Resery4</span>
                </a>
            </li>
        </ul>
    </aside>

    <div class="academic-main">
        <section class="academic-intro" aria-labelledby="about-title">
            <h2 id="about-title">{zh ? '关于我' : 'About'}</h2>
            <p>
                {zh
                    ? '我是一名 Android 与 TEE 安全工程师，研究方向包括系统级安全、漏洞挖掘、利用开发与可信执行环境。'
                    : 'I am an Android and TEE security engineer working on system security, vulnerability discovery, exploit development, and trusted execution environments.'}
            </p>
        </section>

        <section class="academic-section" aria-labelledby="talk-title">
            <h2 id="talk-title">{zh ? '演讲' : 'Talks'}</h2>
            <div class="timeline-entry">
                <time>2026</time>
                <div>
                    <h3>Black Hat USA 2026</h3>
                    <a href="https://blackhat.com/us-26/briefings/schedule/index.html#exploring-the-el2-attack-surface-from-vulnerability-to-full-system-compromise-51679" target="_blank" rel="noopener noreferrer">
                        Exploring the EL2 Attack Surface: From Vulnerability to Full System Compromise ↗
                    </a>
                </div>
            </div>
        </section>

        <section class="academic-section" aria-labelledby="vulnerability-title">
            <h2 id="vulnerability-title">{zh ? '漏洞研究' : 'Vulnerability Research'}</h2>
            <p class="section-lead">MediaTek Security Advisories &amp; CVEs</p>
            <div class="cve-groups">
                {cves.map((group) => (
                    <div class="timeline-entry cve-group">
                        <time>{group.year}</time>
                        <p>
                            {group.items.map((item, index) => (
                                <>
                                    {index > 0 && <span aria-hidden="true"> · </span>}
                                    <span class:list={['cve-item', { 'cve-item--assisted': item === '20521' }]}>
                                        <span>{item}</span>
                                        {item === '20521' && (
                                            <span class="ai-assisted-label">AI-assisted</span>
                                        )}
                                    </span>
                                </>
                            ))}
                        </p>
                    </div>
                ))}
            </div>
            <p class="ai-assisted-note">
                {zh
                    ? 'AI 辅助发现：AI 辅助了部分漏洞发现过程；验证与报告由我完成。'
                    : 'AI-assisted discovery: AI supported parts of the discovery process; validation and reporting were completed by me.'}
            </p>
        </section>

        <slot />
    </div>
</div>
