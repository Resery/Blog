---
import { type CollectionEntry } from 'astro:content';
import ArrowRight from '../assets/icons/arrow-right.svg';
import FormattedDate from './FormattedDate.astro';

type Props = { post: CollectionEntry<'blog'>; class?: string; headingLevel?: 'h2' | 'h3'; locale?: 'en' | 'zh' };

const { post, class: className, headingLevel = 'h2', locale = post.data.lang } = Astro.props;
const { title, permalink, publishDate, updatedDate, excerpt } = post.data;
const TitleTag = headingLevel;
const href = locale === 'zh' ? `/Blog/zh/blog/${permalink}/` : `/Blog/blog/${permalink}/`;
---

<a class:list={['group flex items-start justify-between gap-8', className]} href={href}>
    <div class="grow">
        <TitleTag
            class="font-serif text-xl leading-tight font-medium group-hover:underline group-hover:decoration-dashed group-hover:decoration-1 group-hover:underline-offset-4 sm:text-2xl"
        >
            {title}
        </TitleTag>
        <div class="mt-1 text-sm leading-normal">
            <FormattedDate date={publishDate} locale={locale} />
            {
                updatedDate && (
                    <>
                        {' '}
                        <span>
                                ({locale === 'zh' ? '更新于' : 'Updated on'} <FormattedDate date={updatedDate} locale={locale} />)
                        </span>
                    </>
                )
            }
        </div>
        {excerpt && <div class="mt-3 text-sm leading-normal">{excerpt}</div>}
    </div>
    <div class="hidden font-serif italic opacity-0 transition group-hover:opacity-100 sm:inline-flex sm:shrink-0 sm:items-center sm:gap-1">
        {locale === 'zh' ? '阅读全文' : 'Read Post'} <ArrowRight class="h-4 w-4 fill-current" />
    </div>
</a>
